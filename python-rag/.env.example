# ============================================================
# CONFIGURATION LLM — PHASE 2
# Copier ce fichier en .env et remplir vos clés API
# ============================================================

# --- Anthropic Claude (recommandé) ---
ANTHROPIC_API_KEY=sk-ant-api03-VOTRE_CLE_ICI

# --- Google Gemini (fallback) ---
GOOGLE_API_KEY=AIzaSy-VOTRE_CLE_ICI

# --- Provider à utiliser : "claude" ou "gemini" ---
LLM_PROVIDER=claude

# --- Modèles (optionnel, valeurs par défaut incluses) ---
CLAUDE_MODEL=claude-3-haiku-20240307
GEMINI_MODEL=gemini-1.5-flash

# --- Paramètres LLM ---
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# --- Vector DB ---
COLLECTION_NAME=documents
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
